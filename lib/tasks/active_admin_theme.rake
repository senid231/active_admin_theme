namespace :active_admin_theme do
  desc "Write the machine-specific theme @import (active_admin_theme.generated.css) next to the Tailwind entry file; run it in every build, and git-ignore the generated file"
  task :css, [:entry] do |_task, args|
    require "active_admin_theme/css_import"
    entry = args[:entry] || "app/assets/stylesheets/active_admin.css"
    changes = ActiveAdminTheme::CssImport.write(entry)
    if changes.empty?
      puts "#{entry}: up to date"
    else
      changes.each { |file, result| puts "#{file == :entry ? entry : ActiveAdminTheme::CssImport.generated_path(entry)}: #{result}" }
    end
  end

  namespace :tailwind do
    desc "Print the Tailwind @source lines for the theme's files, or write them to the file named by ACTIVE_ADMIN_THEME_SOURCES (paths relative to that file; git-ignore it and import it from your Tailwind entry file)"
    task :sources do
      file = ENV["ACTIVE_ADMIN_THEME_SOURCES"]
      if file.to_s.empty?
        puts ActiveAdminTheme.tailwind_sources
      else
        path = Pathname.new(file).expand_path
        content = "/* Generated by `rake active_admin_theme:tailwind:sources`. Machine-specific: do not commit. */\n#{ActiveAdminTheme.tailwind_sources(relative_to: path.dirname).join("\n")}\n"
        unchanged = path.file? && path.read == content
        FileUtils.mkdir_p(path.dirname)
        File.write(path, content) unless unchanged
        puts "#{file}: #{unchanged ? "up to date" : "written"}"
      end
    end
  end
end
