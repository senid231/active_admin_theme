<nav data-aat-main-menu class="hidden md:flex items-center self-stretch" aria-label="<%= t('active_admin.toggle_main_navigation_menu') %>">
  <ul role="list" class="flex items-stretch h-full text-[13px]">
    <% current_menu.items(self).each do |item| %>
      <% children = item.items(self).presence %>
      <% url = item.url(self) %>
      <% current = current_menu_item?(item) %>
      <% classes = "flex items-center h-full px-2.5 no-underline text-(--aat-header-text) hover:bg-(--aat-menu-pill) hover:text-(--aat-menu-hover-text) #{'bg-(--aat-menu-pill) text-(--aat-menu-hover-text) selected' if current}" %>
      <li class="relative" data-item-id="<%= item.id %>">
        <% if children %>
          <% menu_id = "top-menu-#{item.id}" %>
          <%= link_to url.presence || "#", item.html_options.merge(class: "#{classes} gap-1", data: { dropdown_toggle: menu_id, dropdown_trigger: "hover", dropdown_placement: "bottom-start", dropdown_offset_distance: 0, dropdown_delay: 100 }) do %>
            <%= item.label(self) %>
            <svg class="size-3.5 shrink-0 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          <% end %>
          <div id="<%= menu_id %>" class="hidden z-40 min-w-40 max-w-65 py-1 text-[13px] bg-(--aat-menu-panel) text-(--aat-menu-text) shadow-lg">
            <%= render "active_admin_theme/menu_flyout", items: children %>
          </div>
        <% elsif url.present? %>
          <%= link_to item.label(self), url, item.html_options.merge(class: classes) %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
