<% breadcrumb_links = build_breadcrumb_links(request.path, class: "no-underline text-inherit hover:text-(--aat-titlebar-text)") %>
<% if breadcrumb_links.present? %>
  <nav aria-label="breadcrumb" class="min-w-0">
    <ol class="flex flex-wrap items-center gap-x-1.5 text-xs uppercase text-(--aat-titlebar-muted)">
      <% breadcrumb_links.each do |link| %>
        <li class="inline-flex items-center gap-1.5">
          <%= link %>
          <span aria-hidden="true">/</span>
        </li>
      <% end %>
    </ol>
  </nav>
<% end %>
